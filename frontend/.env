# Lead Hunter Frontend Environment
#
# If the backend isn't on port 8000 (common on Windows — something else
# is often already squatting on it), change this to match whatever port
# your `uvicorn` command actually printed on startup, e.g.:
#   VITE_API_BASE=http://localhost:8001/api/v1
VITE_API_BASE=http://localhost:8000/api/v1
