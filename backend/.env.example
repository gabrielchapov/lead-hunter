# Copy this to backend/.env for local dev (backend/.env is gitignored).

# CORS — comma-separated origins allowed to call this API.
# Leave unset locally to allow "*" (fine for dev, not for prod).
CORS_ORIGINS=http://localhost:5173

# Login — single-user credentials, checked against POST /api/v1/auth/login.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Signing key for login tokens. Any long random string; rotating it
# invalidates every issued token (forces everyone to log in again).
JWT_SECRET=change-me-too

# Postgres connection string. Omit for local dev — falls back to a local
# SQLite file (prospects.db).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Places (New) API key — enables POST /leads/{id}/enrich to fill
# in phone/website via Text Search + Place Details. Optional: leave unset
# and enrich just honestly confirms whatever OSM already gave us, no
# fabricated data either way. Requires a Google Cloud project with
# Places API (New) enabled and a billing account attached (free tier:
# 10,000 Essentials-field requests/month as of mid-2026 — see
# ROADMAP.md for the cost breakdown).
# GOOGLE_PLACES_API_KEY=
